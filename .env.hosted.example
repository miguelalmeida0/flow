# Disabled preparation template. Not spending authorization. Never commit real keys.
PORT=3000
FLOW_INFERENCE_ENABLED=false
FLOW_PUBLIC_ORIGIN=https://REPLACE_WITH_APPROVED_ORIGIN
FLOW_ENVIRONMENT=staging
FLOW_BUDGET_NAMESPACE=REPLACE_WITH_SINGLE_APPROVED_PARENT
FLOW_CONSENT_VERSION=flow-cloud-v1
FLOW_REDIS_URL=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
FLOW_SESSION_TTL_MS=86400000
FLOW_REQUEST_DEADLINE_MS=15000
FLOW_MAX_INPUT_BYTES=65536
# Conservative server byte/token bounds; verify representative prompts fit.
FLOW_MAX_INPUT_TOKENS=64000
FLOW_MAX_OUTPUT_TOKENS=2048
FLOW_INTERPRET_COST_MICROS=30000
FLOW_SPEECH_RATE_VERIFIED=false
# Verify account opt-out price before enabling speech; these are proposed floors.
FLOW_STT_RATE_MICROS_PER_MINUTE=7700
FLOW_STT_SESSION_COST_MICROS=46200
FLOW_TTS_COST_MICROS=10000
# FLOW_RELEASE_ID is baked into the image. Do not override it in deployment config.
# Operator-only settings, never service boot initialization:
# FLOW_PARENT_DAILY_MICROS=10000000
# FLOW_ENVIRONMENT_DAILY_MICROS=<approved environment sublimit>
# FLOW_IDENTITY_DAILY_REQUESTS=100
# FLOW_IDENTITY_DAILY_AUDIO_MS=900000
# FLOW_GLOBAL_VOICE_LIMIT=5
# FLOW_VOICE_SESSION_MS=300000
# FLOW_AUTHORIZE_NEW_LEDGER is deliberately absent. See HOSTED_FLOW.md.
